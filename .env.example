# PathSnap Backend Environment Configuration (.env)
# Copy to .env and adjust paths as needed.

PATHSNAP_TRAIN_DIR=data/raw/train
PATHSNAP_STUDENT_TEST_DIR=data/raw/student_test
PATHSNAP_EVALUATOR_TEST_DIR=data/evaluator_test
PATHSNAP_PROCESSED_DIR=data/processed
PATHSNAP_CACHE_DIR=data/cache
PATHSNAP_ARTIFACTS_DIR=artifacts
PATHSNAP_EXPERIMENTS_DIR=experiments
PATHSNAP_REPORTS_DIR=reports

# Comma-separated CORS origins or * for two-laptop LAN evaluation
CORS_ORIGINS=*
